<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <RootNamespace>GameGenerated</RootNamespace>
    <LangVersion>10</LangVersion>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GameFramework\GameFramework.csproj" />
    <PackageReference Include="Google.Protobuf" Version="3.28.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\UnityClient\Assets\Scripts\Generated\Data\*.cs"
             Link="Data\%(Filename)%(Extension)" />
    <Compile Include="..\UnityClient\Assets\Scripts\Generated\Network\Protobuf\*.cs"
             Link="Network\Protobuf\%(Filename)%(Extension)" />
    <Compile Include="..\UnityClient\Assets\Scripts\Generated\Network\Protobuf\Generated\*.cs"
             Link="Network\Protobuf\Generated\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
